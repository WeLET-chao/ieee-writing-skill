{
  "name": "minimal",
  "description": "Lightweight profile for digests with only core narrative sections.",
  "input": {
    "glob": "papers/*/analysis.md",
    "index_file": null
  },
  "bibliographic": {
    "title": { "source": "heading", "level": 1 },
    "year": { "source": "table", "field": "Year" },
    "venue": { "source": "table", "field": "Venue" },
    "authors": { "source": "table", "field": "Authors" }
  },
  "sections": {
    "problem_statement": {
      "headings": ["Problem statement", "Research problem", "Problem", "Abstract"],
      "required": true
    },
    "prior_art": {
      "headings": ["Prior art", "Related work", "Background"],
      "required": true
    },
    "category": {
      "headings": ["Category of work", "Research category", "Tags", "Keywords"],
      "parse": "comma_tags",
      "required": false
    },
    "research_opportunity": {
      "headings": ["Research opportunity", "Open problems", "Future directions", "Future work"],
      "required": false
    }
  },
  "aggregation": {
    "group_by": "category.primary",
    "min_theme_papers": 2,
    "spot_check_count": 5,
    "min_section_chars": 30,
    "era_buckets": [2010, 2015, 2020, 2023]
  }
}
